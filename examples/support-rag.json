    "type": "comment",
    "z": "cw-tab-support-rag",
    "name": "Ask: POST /context-weave/ask with { question: \"...\" }",
    "info": "The HTTP gateway/auth layer must inject msg.auth.tenantId from a trusted identity, not from the request body.",
    "x": 225,
    "y": 320,
    "wires": []
  },
  {
    "id": "cw-http-in-ask",
    "type": "http in",
    "z": "cw-tab-support-rag",
    "name": "Ask support KB",
    "url": "/context-weave/ask",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 165,
    "y": 380,
    "wires": [
      [
        "cw-validate-question"
      ]
    ]
  },
  {
    "id": "cw-validate-question",
    "type": "function",
    "z": "cw-tab-support-rag",
    "name": "Validate question and trusted identity",
    "func": "const question = msg.payload?.question;\nif (typeof question !== 'string' || !question.trim()) {\n  msg.statusCode = 400;\n  msg.payload = { error: 'question must be a non-empty string' };\n  return [null, msg];\n}\nif (!msg.auth?.tenantId) {\n  msg.statusCode = 401;\n  msg.payload = {error:'Trusted identity required'};\n  return [null,msg];\n}\nmsg.contextWeave = msg.contextWeave || {};\nmsg.contextWeave.query = question.trim();\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 415,
    "y": 380,
    "wires": [
      [
        "cw-retrieve"
      ],
      [
        "cw-http-response"
      ]
    ]
  },
  {
    "id": "cw-retrieve",
    "type": "context-weave-retrieve",
    "z": "cw-tab-support-rag",
    "name": "Hybrid retrieval",
    "libraries": [
      {
        "library": "cw-support-library",
        "metadataFilter": "status = 'published'",
        "lexicalWeight": 0.05
      }
    ],
    "querySource": "contextWeave.query",
    "querySourceType": "msg",
    "mode": "hybrid",
    "candidateLimit": 25,
    "resultLimit": 8,
    "contextMode": "sentences",
    "sentencesBefore": 1,
    "sentencesAfter": 1,
    "highlights": true,
    "securityContextSource": "auth",
    "securityContextSourceType": "msg",
    "x": 650,
    "y": 380,
    "wires": [
      [
        "cw-rerank"
      ],
      [
        "cw-api-error"
      ]
    ]
  },
  {
    "id": "cw-rerank",
    "type": "context-weave-rerank",
    "z": "cw-tab-support-rag",
    "name": "Diversify evidence",
    "querySource": "contextWeave.query",
    "querySourceType": "msg",
    "evidenceSource": "contextWeave.evidence",
    "evidenceSourceType": "msg",
    "strategy": "mmr",
    "diversityBias": 0.3,
    "limit": 6,
    "x": 865,
    "y": 380,
    "wires": [
      [
        "cw-answer"
