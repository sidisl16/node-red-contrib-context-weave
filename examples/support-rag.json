        "required": true
      },
      {
        "name": "status",
        "type": "string",
        "required": false
      },
      {
        "name": "product",
        "type": "string",
        "required": false
      }
    ],
    "accessPolicy": {
      "mode": "tenant-field",
      "metadataField": "tenant_id",
      "claimProperty": "auth.tenantId"
    },
    "privacy": "local-only"
  },
