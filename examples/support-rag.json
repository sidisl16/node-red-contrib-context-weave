        "cw-api-error"
      ]
    ]
  },
  {
    "id": "cw-answer",
    "type": "context-weave-answer",
    "z": "cw-tab-support-rag",
    "name": "Answer with citations",
    "generationProfile": "cw-answer-profile",
    "querySource": "contextWeave.query",
    "querySourceType": "msg",
    "evidenceSource": "contextWeave.evidence",
    "evidenceSourceType": "msg",
    "maxEvidenceChunks": 6,
    "maxEvidenceChars": 18000,
    "instructions": "Answer only from the supplied evidence. Cite each factual claim using the supplied evidence references. If the evidence is insufficient, say that you do not know.",
    "citationFormat": "structured-and-numeric",
    "requireCitations": true,
    "noEvidenceBehavior": "say-unknown",
    "streamMode": "off",
    "x": 1080,
    "y": 380,
    "wires": [
      [],
      [
        "cw-format-response"
      ],
      [
        "cw-api-error"
      ]
    ]
  },
  {
    "id": "cw-format-response",
    "type": "change",
    "z": "cw-tab-support-rag",
    "name": "Return answer + citations",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"answer\":contextWeave.answer.text,\"citations\":contextWeave.answer.citations,\"requestId\":contextWeave.requestId}",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1295,
    "y": 380,
    "wires": [
      [
        "cw-response-route"
      ]
    ]
  },
  {
    "id": "cw-api-error",
    "type": "function",
    "z": "cw-tab-support-rag",
    "name": "Return safe API error",
    "func": "const detail = msg.error || msg.contextWeave?.error || {};\nmsg.statusCode = detail.code === 'NOT_FOUND' ? 404 : detail.code === 'VALIDATION' ? 400 : detail.code === 'RATE_LIMITED' ? 429 : 502;\nmsg.payload = { error: detail.code || 'RAG_ERROR', message: detail.message || 'The knowledge service could not complete the request.', requestId: msg.contextWeave?.requestId };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1110,
    "y": 450,
    "wires": [
      [
        "cw-http-response"
      ]
    ]
  },
